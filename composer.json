{
    "name": "ilbronza/static-site",
    "description": "Generate a self-contained static website from explicitly registered Laravel routes and page sources",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "illuminate/console": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\StaticSite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\StaticSite\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\StaticSite\\StaticSiteServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "homepage": "https://github.com/ilBronza/StaticSite",
    "keywords": [
        "laravel",
        "static-site",
        "static-site-generator",
        "html",
        "export"
    ],
    "authors": [
        {
            "name": "Davide Bronzini",
            "homepage": "https://github.com/ilBronza"
        }
    ],
    "support": {
        "issues": "https://github.com/ilBronza/StaticSite/issues",
        "source": "https://github.com/ilBronza/StaticSite"
    }
}
